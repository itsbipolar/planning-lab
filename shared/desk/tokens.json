{
  "_note": "Design tokens for the Data desk look (2026-11-13; redesign v2 step 2 adds type roles and the stripes ramp). Run npm run tokens: writes src/styles/tokens.css and checks text contrast. planning-lab/shared/desk/tokens.json is a copy.",
  "dark": {
    "ground": "#0E1318",
    "raised": "#151C23",
    "ink": "#F2F4F6",
    "ink2": "#C7CFD7",
    "ink3": "#97A2AD",
    "point": "#F2A93B",
    "money": "#7FC79A",
    "rule": "#26303A",
    "d1": "#5AA2E0",
    "d2": "#F2A93B",
    "d3": "#4FBFAE",
    "d4": "#E07A6F",
    "neutral": "#3A4652"
  },
  "light": {
    "ground": "#FCFDFD",
    "raised": "#E8EEF3",
    "ink": "#10161C",
    "ink2": "#36414C",
    "ink3": "#56616C",
    "point": "#F2A93B",
    "pointDeep": "#A8690A",
    "money": "#2C6E44",
    "rule": "#D3D8DD",
    "d1": "#1F64A8",
    "d2": "#B9740A",
    "d3": "#157A6E",
    "d4": "#B5473B",
    "neutral": "#C3CAD1"
  },
  "fonts": {
    "display": "\"Source Serif 4 Variable\", Georgia, serif",
    "ui": "\"Source Sans 3 Variable\", system-ui, sans-serif",
    "mono": "\"IBM Plex Mono\", ui-monospace, monospace"
  },
  "type": {
    "_note": "Type roles (redesign v2 section 6). Sizes never go below the earlier ones (Mo: text too small): body stays 20px on the site and 19.5px in the tools, small text 18px, labels 17.5px or more; the display leading is 1.05 so descenders clear the next line.",
    "display": {
      "family": "display",
      "weight": 500,
      "opsz": 60,
      "size": "clamp(2.6rem, 4.4vw + 1rem, 5.25rem)",
      "line": "1.05",
      "tracking": "-0.025em",
      "measure": "16ch"
    },
    "section": {
      "family": "display",
      "weight": 600,
      "opsz": 48,
      "size": "clamp(2rem, 1.6vw + 1.5rem, 2.75rem)",
      "line": "1.05",
      "tracking": "-0.015em"
    },
    "card": {
      "family": "display",
      "weight": 600,
      "size": "clamp(1.6rem, 1.4vw + 1rem, 2.2rem)",
      "line": "1.08",
      "tracking": "-0.01em",
      "measure": "22ch"
    },
    "dek": {
      "family": "ui",
      "weight": 400,
      "size": "1.375rem",
      "line": "1.45",
      "measure": "46ch"
    },
    "label": {
      "family": "ui",
      "weight": 700,
      "size": "max(17.5px, 0.95rem)",
      "tracking": ".06em",
      "case": "uppercase"
    },
    "readout": {
      "family": "display",
      "weight": 600,
      "size": "clamp(3rem, 6vw, 4.5rem)",
      "line": "1",
      "numeric": "tabular-nums lining-nums"
    },
    "small": {
      "size": "18px"
    }
  },
  "stripes": {
    "_note": "The price-stripes ramp, falls to rises (redesign v2): stops at these yearly price changes in percent, OKLab mixes between them (dark: lightness and chroma mixed, the more colourful stop's hue kept, so small rises read as muted amber, not olive). The flat stop is the scheme's neutral token. In dark mode no stripe is lighter than ink3.",
    "at": [
      -6,
      -2,
      0,
      3.5,
      6,
      8
    ],
    "light": [
      "#1F64A8",
      "#9DBBD8",
      "neutral",
      "#E9C27A",
      "#B9740A",
      "#7A3E08"
    ],
    "dark": [
      "#1F64A8",
      "#4F7AA3",
      "neutral",
      "#B8862A",
      "#D08A10",
      "#8E4A0C"
    ]
  }
}
